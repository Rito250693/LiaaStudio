# Ambiente de ejecución: development | staging | production
LIAA_ENV=development

# Puerto para servidor de producción (npm start)
PORT=3000

# Secretos externos a SQLite (OBLIGATORIOS en producción; 64 caracteres hex / 32 bytes)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIAA_ENCRYPTION_KEY=
LIAA_SESSION_SECRET=

# Forzar cookies seguras y encabezados HTTPS en producción
LIAA_ENFORCE_HTTPS=false

# Activar SOLO si hay un proxy reverso confiable (Nginx/Apache) enviando X-Forwarded-For
LIAA_TRUST_PROXY=false

# Registro público desactivado por defecto (recomendado: false)
LIAA_PUBLIC_REGISTRATION=false

# Credenciales iniciales solo si se crea una base de datos nueva vacía (mín. 10 caracteres)
LIAA_ADMIN_USER=admin
LIAA_ADMIN_PASS=CAMBIA_ESTA_CLAVE_SEGURA_2026!

# Configuración opcional de correo SMTP para recuperación de contraseña
# (Ej. Gmail: smtp.gmail.com puerto 587 con Contraseña de Aplicación, u Office 365: smtp.office365.com puerto 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LIAA Studio UAZ <no-reply@liaa.uaz.edu.mx>"
LIAA_PUBLIC_URL=http://localhost:5173
